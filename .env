# 社交链接
## 请在 src/assets/socialLinks.json 文件中配置

# 网站链接
## 请在 src/assets/siteLinks.json 文件中配置
## 网站链接的图标名称可前往 https://www.xicons.org 自行挑选并在 src/components/Links/index.vue 中引入

# 天气 Key
## 留空默认使用作者内置的备用公共接口（开箱即用，如需更稳可后续申请腾讯位置服务 Key 填入）
VITE_TX_WEATHER_KEY = "" # 腾讯位置服务 Key
VITE_GD_WEATHER_KEY = "" # 高德开放平台 Key
VITE_GOOGLE_WEATHER_KEY = "" # Google 位置服务 Key (非大陆地区服务)

# 建站日期
## 按照当前年份填写，若不需要可留空
VITE_SITE_START = "2026-11-13"

# ICP 备案号（已清空原作者的豫ICP备案）
VITE_SITE_ICP = ""
VITE_SITE_MPS = ""

# 歌曲 API 地址（保留原作者可用的公共 Meting 接口与默认歌单，如需关闭音乐可将 VITE_SONG_ID 留空）
VITE_SONG_API = "https://metingapi.nanorocky.top/"
# 歌曲服务器 ( netease-网易云, tencent-qq音乐 )
VITE_SONG_SERVER = "netease"
VITE_SONG_SERVER_SECOND = "tencent"
# 播放类型 ( song-歌曲, playlist-播放列表, album-专辑, search-搜索, artist-艺术家 )
VITE_SONG_TYPE = "playlist"
# 播放 ID ( 若无需播放器，请设为空即可 )
VITE_SONG_ID = "9379831714"
VITE_SONG_ID_SECOND = "9518088898"

# 文字转语音 API 地址（未部署保持留空即可）
VITE_TTS_API = ""
VITE_TTS_Voice = "zh-CN-YunxiNeural"
VITE_TTS_Style = "chat"

# 鉴权参数（默认留空即可）
VITE_TX_WEATHER_SKEY = "" # 腾讯位置服务鉴权SKEY
VITE_GD_WEATHER_SKEY = "" # 高德位置服务鉴权SKEY
VITE_TTS_SKEY = "" # 文字转语音鉴权 SKEY
VITE_METING_SKEY = "" # METING API 鉴权 SKEY
VITE_SFILE_SKEY = "" # 特殊文件 API 鉴权 SKEY
VITE_METING_SKEY_TTL = "15000" # METING API 签名有效期
